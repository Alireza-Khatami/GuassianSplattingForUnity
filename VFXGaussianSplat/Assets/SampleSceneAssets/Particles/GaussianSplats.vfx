  m_Name: 
  m_EditorClassIdentifier: 
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966674976}
  m_Children: []
  m_UIPosition: {x: -513, y: 1318}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661616120}
  - {fileID: 8926484042661616124}
  - {fileID: 8926484042661616128}
  m_OutputSlots:
  - {fileID: 8926484042661616132}
  - {fileID: 8926484042661616136}
  m_OperatorName: Custom HLSL
  m_HLSLCode: "void SelectAxes(float3 X, float3 Y, float3 Z, out float3 x, out float3
    y)\r\n{\r\n    float3 viewX = TransformWorldToViewDir(X);\r\n    float3 viewY
    = TransformWorldToViewDir(Y);\r\n    float3 viewZ = TransformWorldToViewDir(Z);\r\n\r\n   
    float areaXY = abs(viewX.x * viewY.y - viewX.y * viewY.x);\r\n    float areaYZ
    = abs(viewY.x * viewZ.y - viewY.y * viewZ.x);\r\n    float areaXZ = abs(viewX.x
    * viewZ.y - viewX.y * viewZ.x);\r\n\r\n    float xyMask = step(areaYZ, areaXY)
    * step(areaXZ, areaXY);\r\n    float yzMask = step(areaXY, areaYZ) * step(areaXZ,
    areaYZ);\r\n    float xzMask = step(areaXY, areaXZ) * step(areaYZ, areaXZ);\r\n\r\n   
    x = xyMask * X + yzMask * Y + xzMask * X;\r\n    y = xyMask * Y + yzMask * Z
    + xzMask * Z;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: SelectAxes
    selectedIndex: 0
